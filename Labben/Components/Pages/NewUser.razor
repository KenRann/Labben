@page "/NewUser"
@rendermode InteractiveServer



 @if (isShowing)
{
    <h3 style="font-size: 50px;">Welcome!</h3>
    <div>
        <p style="text-decoration: underline; font-size: 20px">Fill in the form: </p>
    </div>

    <EditForm Model="person" OnValidSubmit="ValidSubmitHandling">        
        <ObjectGraphDataAnnotationsValidator />
        
        @*-- Personal --*@
        First name:
        <div>
            <InputText id="FirstName" @bind-Value="person.Name" />
            <ValidationMessage For="@(() => person.Name)" />
        </div>  
        
        Last name:
        <div>
            <InputText id="LastName" @bind-Value="person.LastName" />
            <ValidationMessage For="@(() => person.LastName)" />
        </div>

        E-mail: 
        <div>
            <InputText id="Email" @bind-Value="person.EMail" />
            <ValidationMessage For="@(() => person.EMail)" />
        </div>
        
        @*-- Company --*@
        Company: 
        <div>
            <InputText id="CompanyName" @bind-Value="person.Company.Name" />
            <ValidationMessage For="@(() => person.Company.Name)" />
        </div>
        
        Company catch phrase: 
        <div>
            <InputText id="CompanyCPhrase" @bind-Value="person.Company.CatchPhrase" />
            <ValidationMessage For="@(() => person.Company.CatchPhrase)" />
        </div> 
        
        @*-- Residence --*@
        Street: 
        <div>
            <InputText id="Street" @bind-Value="person.Address.Street" />
            <ValidationMessage For="@(() => person.Address.Street)" />
        </div>

        City: 
        <div>
            <InputText id="City" @bind-Value="person.Address.City" />
            <ValidationMessage For="@(() => person.Address.City)" />
        </div>

        Zip code:
        <div>
            <InputText id="ZipCode" @bind-Value="person.Address.ZipCode" />
            <ValidationMessage For="@(() => person.Address.ZipCode)" />
        </div>
    
        <div style="margin-bottom: 10px; margin-top: 20px;">
            <button type="Submit" >Save</button>
            
        </div>

    </EditForm>
    <button @onclick="QuickAddUser">Too lazy to manually type info?</button>
}
else
{
    <h4 style="font-size: 50px;">Thank you!</h4>
    
    <div>
        <p style="text-decoration: underline; font-size: 20px"> This is the submitted data: </p>
    </div>
    @*-- Personal --*@
    <p style="font-size: 16px; text-decoration: underline; margin: 20px 40px 20px">Personal information</p>
    <p>Id: @person.Id</p>
    <p>First name: @person.Name</p>
    <p>Last name: @person.LastName</p>
    <p>E-Mail: @person.EMail</p>

    @*-- Company --*@
    <p style="font-size: 16px; text-decoration: underline; margin: 20px 40px 20px">Company information</p>
    <p>Company: @person.Company.Name</p>
    <p>Company catch phrase: @person.Company.CatchPhrase</p>

    @*-- Residence --*@
    <p style="font-size: 16px; text-decoration: underline; margin: 20px 40px 20px">Residence information</p>
    <p>Street: @person.Address.Street</p>
    <p>City: @person.Address.City</p>
    <p>Zip code: @person.Address.ZipCode</p>

    <button @onclick="AddAnotherUser">New user</button>
} 

@code {
    Person person = new Person(0, "", "", "", new Company("", ""), new Address("", "", "")); 

    UserList listOfUsers = new UserList();
    bool isShowing = true;
    Random random = new Random();

    private void ValidSubmitHandling()
    {        
        GenerateUserID();
        listOfUsers.AddUser(
            person.Id, 
            person.Name, 
            person.LastName, 
            person.EMail, 
            person.Company.Name,
            person.Company.CatchPhrase, 
            person.Address.Street, 
            person.Address.City, 
            person.Address.ZipCode
        );
        isShowing = false;
    }

    private void AddAnotherUser()
    {
        isShowing = true;
        person = new Person(0, "", "", "", new Company("", ""), new Address("", "", ""));
    }

    private void QuickAddUser()
    {
        person.Name = "Karl";
        person.LastName = "Bengtsson";
        person.EMail = "karl.bengtsson@gmail.com";
        person.Company.Name = "Snett, vint och skevt AB";
        person.Company.CatchPhrase = "Ring gärna, men inte oss.";
        person.Address.Street = "Nonya 1";
        person.Address.City = "Ingenmannsland";
        person.Address.ZipCode = "16545";
    }

    private void GenerateUserID()
    {
        person.Id = random.Next(0, 9999);

        foreach (var id in listOfUsers.GetId())
        {
            if (person.Id == id)
            {
                person.Id = random.Next(0, 9999);
            }
        }
    }
}
