@page "/Users"
@rendermode @(new InteractiveServerRenderMode(false))
@attribute [StreamRendering]
@using Microsoft.AspNetCore.Components.QuickGrid;

<PageTitle>Users</PageTitle>

@if (_showList != true)     
{
    <p class="text-center" style="font-size: 20px; margin: 150px 40px 30px 50px"><em>Loading users...</em></p>
    <p class="text-center">
        <iframe src="https://giphy.com/embed/3oEjI6SIIHBdRxXI40"
                width="380"
                height="380"
                style=""
                frameBorder="0"
                class="giphy-embed"
                allowFullScreen>
        </iframe>
    </p>
}

else
{
    <h1 style="text-decoration: underline; text-align: center">Users</h1>

    <div class="search-box">
        <label for="listSource">List: </label>
        <select id="listSource" @onchange="ListOption">
            <option value="A">A</option>
            <option value="B">API</option>
        </select>
        <button @onclick="@ShowListAmount">@_buttonText</button>
        <input type="search" @bind="_listFilter" @bind:event="oninput" placeholder="Search..." />
    </div>

    <QuickGrid Items="@FilterUser">
        <PropertyColumn Property="@(u => u.Id)" Sortable="true" />
        <PropertyColumn Property="@(u => u.Name)" Sortable="true" />
        @if (_showColumn)
        {
        <PropertyColumn Property="@(u => u.UserName)" Sortable="true" Title="Username" />
        }
        <PropertyColumn Property="@(u => u.EMail)" Sortable="true" Title="E-mail" />
        <PropertyColumn Property="@(u => u.Company.Name)" Sortable="true" Title="Company" />
        <PropertyColumn Property="@(u => u.Company.CatchPhrase)" Sortable="true" Title="Catch phrase" />
        <PropertyColumn Property="@(u => u.Address.Street)" Sortable="true" />
        <PropertyColumn Property="@(u => u.Address.City)" Sortable="true" />
        <PropertyColumn Property="@(u => u.Address.ZipCode)" Sortable="true" Title="Zip code" />
    </QuickGrid>
}

@code {
    UserList users = new UserList();
    APIDataAccess usersAPI = new APIDataAccess();
    IQueryable<Person>? userList;
    bool _showList = false;
    int _limitByAmount = 5;
    string? _listFilter; 
    bool _showColumn = false;
    bool _limitList = true;
    string _buttonText => _limitList ? "Show all" : "Show less";

    IQueryable<Person> FilterUser
    {
        get
        {
            var result = userList;
            if (!string.IsNullOrEmpty(_listFilter))
            {
                result = result?.Where(u =>
                    u.Id.ToString().Contains(_listFilter, StringComparison.OrdinalIgnoreCase) ||
                    u.Name.Contains(_listFilter, StringComparison.OrdinalIgnoreCase) ||
                    u.UserName.Contains(_listFilter, StringComparison.OrdinalIgnoreCase) ||
                    u.Company.Name.Contains(_listFilter, StringComparison.OrdinalIgnoreCase) ||
                    u.Company.CatchPhrase.Contains(_listFilter, StringComparison.OrdinalIgnoreCase) ||
                    u.Address.Street.Contains(_listFilter, StringComparison.OrdinalIgnoreCase) ||
                    u.Address.City.Contains(_listFilter, StringComparison.OrdinalIgnoreCase) ||
                    u.Address.ZipCode.ToString().Contains(_listFilter, StringComparison.OrdinalIgnoreCase)
                );
            }
            if (_limitList)
            {
                result = result?.Take(_limitByAmount);
            }
            return result;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await Task.Delay(2000);
        userList = SortBy(users);
        _showList = true;
    }

    private async Task ListOption(ChangeEventArgs option)
    {
        string? select = option.Value?.ToString();
        switch (select)
        {
            case "A":
                userList = SortBy(users);
                _showColumn = false;
                break;

            case "B":               
                userList = await SortByAsync(usersAPI);
                _showColumn = true;
                break;

            default:
                break;
        }
    }
   
    private async Task<IQueryable<Person>> SortByAsync(IGetUsers listOfUsers)
    {
        var users = await listOfUsers.GetUsersAsync();
        IQueryable<Person> id = users.OrderBy(u => u.Id).ThenBy(u => u.Name);
        return id;
    }

    private IQueryable<Person> SortBy(IGetUsers listOfUsers)
    {
        IQueryable<Person> firstName = listOfUsers.GetUsers().OrderBy(u => u.Name).ThenBy(u => u.Id);

        return firstName;
    }

    private void ShowListAmount()
    {
        _limitList = !_limitList;
    }
}

