@page "/Users"
@* @rendermode InteractiveServer *@  @*Can't use rendermode. It made the page load twice*@
@attribute [StreamRendering] 

<PageTitle>Users</PageTitle>

<h1>Users</h1>



@if (showList != true)          @*Gotta do it like this since the list is being loaded to fast*@
{
    <p><em>Loading...</em></p>    
    <p>
        <img src="/true.png"/>  @*Placeholder imagery*@
    </p>
}

else
{
    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Email</th>
                <th>Company</th>
                <th>Company Catch Phrase</th>
                <th>Street</th>
                <th>City</th>
                <th>Zipcode</th>
            </tr>
        </thead>
        <tbody>
            @foreach (Person user in userList.GetUsers())
            {
                <tr>
                    <td>@user.Id</td>
                    <td>@user.FirstName</td>
                    <td>@user.LastName</td>
                    <td>@user.EMail</td>
                    <td>@user.Company.CompanyName</td>
                    <td>@user.Company.CompanyCPhrase</td>
                    <td>@user.Residence.Street</td>
                    <td>@user.Residence.City</td>
                    <td>@user.Residence.ZipCode</td>
                </tr>
            }
        </tbody>

    </table>
} 
    
@* <button @onclick="LoadingList">loadlist</button> *@


@code {
    UserList userList = new UserList();
    GeneratedPerson genPerson = new GeneratedPerson();
    bool showList = false;

    

    protected override async Task OnInitializedAsync()
    {       
        await Task.Delay(2000);
        showList = true;     
    }


    
    async Task LoadingList()
    {                       
    }

    private void PlaceHolder()
    {
        userList.GetUsers();

    }

   

    

}
