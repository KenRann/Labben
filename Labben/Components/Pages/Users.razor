@page "/Users"
@rendermode @(new InteractiveServerRenderMode(false))
@* @rendermode InteractiveServer *@
@*Can't use rendermode. It made the page load twice*@
@attribute [StreamRendering]
@using Microsoft.AspNetCore.Components.QuickGrid;


<PageTitle>Users</PageTitle>

<h1 style="text-decoration: underline">Users</h1>



@if (showList != true)          @*Gotta do it like this since the list is being loaded to fast*@
{
    <p><em>Loading...</em></p>
    <p>
        <img src="/true.png" style="width: 500px; height: auto;" />  @*Placeholder imagery*@
    </p>
}

else
{
      <QuickGrid Items="@FilterUser" >     
        <PropertyColumn Property="@(u => u.Id)" Sortable="true" />
        <PropertyColumn Property="@(u => u.FirstName)" Sortable="true"  />
        <PropertyColumn Property="@(u => u.LastName)" Sortable="true" />
        <PropertyColumn Property="@(u => u.EMail)" Sortable="true" />
        <PropertyColumn Property="@(u => u.Company.CompanyName)" Sortable="true" />
        <PropertyColumn Property="@(u => u.Company.CompanyCPhrase)" Sortable="true" />
        <PropertyColumn Property="@(u => u.Residence.Street)" Sortable="true" />
        <PropertyColumn Property="@(u => u.Residence.City)" Sortable="true" />
        <PropertyColumn Property="@(u => u.Residence.ZipCode)" Sortable="true" />
    </QuickGrid>
    <div class="search-box">
        <input type="search" @bind="listFilter" @bind:event="oninput"  />
    </div>

    <button @onclick="@ShowListAmount">@buttonText</button>
}

@code {
    UserList listOfUsers = new UserList();
    IQueryable<Person>? userList;

    int limitByAmount = 5;
    string? listFilter;
    bool showList = false;

    bool limitList = true;
    string buttonText => limitList? "Show more" : "Show less" ;

    IQueryable<Person> FilterUser { get { 
            var result = userList;
            if (!string.IsNullOrEmpty(listFilter))
            {
                result = result?.Where(u =>
                    u.Id.ToString().Contains(listFilter, StringComparison.OrdinalIgnoreCase) ||
                    u.FirstName.Contains(listFilter, StringComparison.OrdinalIgnoreCase) || 
                    u.LastName.Contains(listFilter, StringComparison.OrdinalIgnoreCase) ||
                    u.Company.CompanyName.Contains(listFilter, StringComparison.OrdinalIgnoreCase) ||
                    u.Company.CompanyCPhrase.Contains(listFilter, StringComparison.OrdinalIgnoreCase) ||
                    u.Residence.Street.Contains(listFilter, StringComparison.OrdinalIgnoreCase) ||
                    u.Residence.City.Contains(listFilter, StringComparison.OrdinalIgnoreCase) ||
                    u.Residence.ZipCode.ToString().Contains(listFilter, StringComparison.OrdinalIgnoreCase)               
                );
            }
            if(limitList)
            {
                result = result?.Take(limitByAmount);
            }
            return result; } 
    }

    protected override async Task OnInitializedAsync()
    {

        userList = SortByFirstName(listOfUsers);
        await Task.Delay(2000);
        showList = true;
    }

    private IQueryable<Person> SortByFirstName(UserList listOfUsers)
    {
        IEnumerable<Person> firstName =
        from user in listOfUsers.GetUsers()
        orderby user.FirstName ascending
        select user;
        return firstName.ToList().AsQueryable();
    }

    private void ShowListAmount()
    {
        limitList = !limitList;
    }
}

