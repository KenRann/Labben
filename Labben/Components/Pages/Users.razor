@page "/Users"
@* @rendermode InteractiveServer *@  @*Can't use rendermode. It made the page load twice*@
@attribute [StreamRendering] 

<PageTitle>Users</PageTitle>

<h1>Users</h1>



@if (showList != true)          @*Gotta do it like this since the list is being loaded to fast*@
{
    <p><em>Loading...</em></p>    
    <p>
        <img src="/true.png"/>  @*Placeholder imagery*@
    </p>
}

else
{
    <table>
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th></th>
                <th></th>
                <th></th>
            </tr>
        </thead>
        @foreach (Person user in genPerson.ReturnListAsync())
        {
    <p>@user.Company.CompanyName</p>
}
    </table>
} 
    
@* <button @onclick="LoadingList">loadlist</button> *@


@code {
    GeneratedPerson genPerson = new GeneratedPerson();
    bool showList = false;

    

    protected override async Task OnInitializedAsync()
    {       
        await Task.Delay(2000);
        showList = true;     
    }


    
    async Task LoadingList()
    {                       
    }

    private void PlaceHolder()
    {
        genPerson.ReturnListAsync();

    }

   

    

}
