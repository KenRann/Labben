@page "/Users"
@rendermode @(new InteractiveServerRenderMode(false))
 @* @rendermode InteractiveServer   *@
@*Can't use rendermode. It made the page load twice*@
@attribute [StreamRendering]
@using Microsoft.AspNetCore.Components.QuickGrid;


<PageTitle>Users</PageTitle>

<h1 style="text-decoration: underline">Users</h1>



@if (showList != true)          @*Gotta do it like this since the list is being loaded to fast*@
{
    <p><em>Loading...</em></p>
    <p>
        <img src="/true.png" style="width: 500px; height: auto;" />  @*Placeholder imagery*@
    </p>
}

else
{
    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>First Name</th>
                <th>Last Name</th>
                <th>Email</th>
                <th>Company</th>
                <th>Company Catch Phrase</th>
                <th>Street</th>
                <th>City</th>
                <th>Zipcode</th>
            </tr>
        </thead>
        <tbody>

            @foreach (Person user in SortByFirstName(listOfUsers))            
            {
                <tr>
                    <td>@user.Id</td>
                    <td>@user.FirstName</td>
                    <td>@user.LastName</td>
                    <td>@user.EMail</td>
                    <td>@user.Company.CompanyName</td>
                    <td>@user.Company.CompanyCPhrase</td>
                    <td>@user.Residence.Street</td>
                    <td>@user.Residence.City</td>
                    <td>@user.Residence.ZipCode</td>
                </tr>
            }
        </tbody>

    </table>

      <QuickGrid Items="@FilterUser">     
        <PropertyColumn Property="@(u => u.Id)" Sortable="true" />
        <PropertyColumn Property="@(u => u.FirstName)" Sortable="true" IsDefaultSortColumn="true">
                        <ColumnOptions>
                <div class="search-box">
                    <input type="search" autofocus @bind="listFilter" @bind:event="oninput" placeholder="User first name"/>
                </div>
            </ColumnOptions>
        </PropertyColumn>
        <PropertyColumn Property="@(u => u.LastName)" Sortable="true" />
        <PropertyColumn Property="@(u => u.EMail)" Sortable="true" />
        <PropertyColumn Property="@(u => u.Company.CompanyName)" Sortable="true" />
        <PropertyColumn Property="@(u => u.Company.CompanyCPhrase)" Sortable="true" />
        <PropertyColumn Property="@(u => u.Residence.Street)" Sortable="true" />
        <PropertyColumn Property="@(u => u.Residence.City)" Sortable="true" />
        <PropertyColumn Property="@(u => u.Residence.ZipCode)" Sortable="true" />
    </QuickGrid>
}

@* <button @onclick="LoadingList">loadlist</button> *@


@code {
    UserList listOfUsers = new UserList();
    IQueryable<Person>? userList;
    bool showList = false;
    string? listFilter;

    IQueryable<Person> FilterUser { get { var result = userList; if (!string.IsNullOrEmpty(listFilter)){ result = result?.Where(u => u.FirstName.Contains(listFilter)); } return result; } }

    protected override async Task OnInitializedAsync()
    {
        userList = await listOfUsers.GetUsers();
        await Task.Delay(2000);
        showList = true;
    }

    public List<Person> SortByFirstName(UserList listOfUsers)
    {
        IEnumerable<Person> firstName =
        from user in listOfUsers.GetUsers()
        orderby user.FirstName ascending
        select user;
        return firstName.ToList();
    }







}
