@page "/Users"
@rendermode @(new InteractiveServerRenderMode(false))
  @* @rendermode InteractiveServer   *@
@*Can't use rendermode. It made the page load twice*@
@attribute [StreamRendering]
@using Microsoft.AspNetCore.Components.QuickGrid;


<PageTitle>Users</PageTitle>

<h1 style="text-decoration: underline">Users</h1>

@if (showList != true)          @*Gotta do it like this since the list is being loaded to fast*@
{
    <p><em>Loading...</em></p>
    <p>
        <img src="/true.png" style="width: 500px; height: auto;" />  @*Placeholder imagery*@
    </p>
}

else
{
      <QuickGrid Items="@FilterUser" >     
        <PropertyColumn Property="@(u => u.Id)" Sortable="true" />
        <PropertyColumn Property="@(u => u.Name)" Sortable="true"  />
        <PropertyColumn Property="@(u => u.EMail)" Sortable="true" />
        <PropertyColumn Property="@(u => u.Company.Name)" Sortable="true" />
        <PropertyColumn Property="@(u => u.Company.CatchPhrase)" Sortable="true" />
        <PropertyColumn Property="@(u => u.Address.Street)" Sortable="true" />
        <PropertyColumn Property="@(u => u.Address.City)" Sortable="true" />
        <PropertyColumn Property="@(u => u.Address.ZipCode)" Sortable="true" />
    </QuickGrid>
    <div class="search-box">
        <input type="search" @bind="listFilter" @bind:event="oninput" placeholder="Search..." />
    </div>

    <button @onclick="@ShowListAmount">@buttonText</button>
}

@code {
    UserList listOfUsers = new UserList();
    APIDataAccess apiUsers = new APIDataAccess();
    IQueryable<Person>? userList;


    int limitByAmount = 5;
    string? listFilter;
    bool showList = false;

    bool limitList = true;
    string buttonText => limitList? "Show more" : "Show less" ;

    IQueryable<Person> FilterUser { get { 
            var result = userList;
            if (!string.IsNullOrEmpty(listFilter))
            {
                result = result?.Where(u =>
                    u.Id.ToString().Contains(listFilter, StringComparison.OrdinalIgnoreCase) ||
                    u.Name.Contains(listFilter, StringComparison.OrdinalIgnoreCase) || 
                    u.Company.Name.Contains(listFilter, StringComparison.OrdinalIgnoreCase) ||
                    u.Company.CatchPhrase.Contains(listFilter, StringComparison.OrdinalIgnoreCase) ||
                    u.Address.Street.Contains(listFilter, StringComparison.OrdinalIgnoreCase) ||
                    u.Address.City.Contains(listFilter, StringComparison.OrdinalIgnoreCase) ||
                    u.Address.ZipCode.ToString().Contains(listFilter, StringComparison.OrdinalIgnoreCase)               
                );
            }
            if(limitList)
            {
                result = result?.Take(limitByAmount);
            }
            return result; } 
    }

    protected override async Task OnInitializedAsync()
    {
        await Task.Delay(500);
        // userList = apiUsers.GetUsers();
        // userList = SortByFirstName(listOfUsers);       
        userList = await apiUsers.GetUsersAsync();       
        showList = true;
    }

    private IQueryable<Person> SortByFirstName(IGetUsers listOfUsers)
    {
        IQueryable<Person> firstName = listOfUsers.GetUsersSync().OrderBy(u => u.Name).ThenBy(u => u.Id);

        return firstName;
    }

    private void ShowListAmount()
    {
        limitList = !limitList;
    }
}

